PORT=4001
# API key de Gemini (capa gratuita) — la misma que uses en Prisma sirve, o generá una nueva en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Contraseña del panel de administración (sección /admin.html) — misma que uses
# en prisma_2 (ADMIN_PASSWORD) para poder loguearte una sola vez.
ADMIN_PASSWORD=
