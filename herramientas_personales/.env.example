PORT=4001
# Contraseña del panel de administración (sección /admin.html) — misma que uses
# en prisma_2 (ADMIN_PASSWORD) para poder loguearte una sola vez.
ADMIN_PASSWORD=

# --- CRM personal (/crm.html) ---
# Resumen diario por mail con los objetivos del día. Si se dejan vacías, el CRM
# funciona igual y los recordatorios se ven solo en el panel.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CRM_MAIL_TO=
CRM_MAIL_HORA=08:00
