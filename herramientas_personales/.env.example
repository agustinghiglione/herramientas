PORT=4001
# Contraseña del panel de administración (sección /admin.html) — misma que uses
# en prisma_2 (ADMIN_PASSWORD) para poder loguearte una sola vez.
ADMIN_PASSWORD=

# --- CRM personal (/crm.html) ---
# Resumen diario por mail con los objetivos del día. Si se dejan vacías, el CRM
# funciona igual y los recordatorios se ven solo en el panel.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CRM_MAIL_TO=
CRM_MAIL_HORA=08:00

# --- Clientes Maps (/crm.html#clientes) ---
# Planilla Clientes_Maps vía Apps Script: ver google-apps-script/clientes_maps.gs
CLIENTES_SCRIPT_URL=
CLIENTES_SCRIPT_CLAVE=
# Mail API de Hostinger (hPanel → Correos → Agentic Mail → API access)
MAIL_API_TOKEN=
MAIL_REMITENTE=contacto@consultoraprisma.digital
MAIL_NOMBRE=Consultora Prisma
# Firma al pie de los mails (\n = salto de línea)
MAIL_FIRMA=
# Cada cuántos minutos se revisan las respuestas (mínimo 2)
MAIL_REVISAR_MIN=10
# Link de Google Calendar para que el cliente agende la reunión
AGENDA_URL=
# Si el cliente responde con interés, se le manda AGENDA_URL solo (poné false para hacerlo a mano)
AUTO_AGENDA=true
DIAGNOSTICO_URL=https://consultoraprisma.digital
PUBLIC_URL=https://herramientas.consultoraprisma.digital
